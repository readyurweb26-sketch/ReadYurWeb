  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  // pressing Escape closes it too, but only while it's actually open
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.style.display === 'flex') closeModal();
  });

  /* ============ screenshot upload handling ============ */

  /**
   * Reads a File object into a base64 string (no "data:..." prefix),
   * which is the format the Apps Script side expects to decode.
   * FileReader is the standard browser API for turning a selected file
   * into actual bytes the page can use.
   */
  function readFileAsBase64(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        // reader.result looks like "data:image/png;base64,iVBORw0KG..." —
        // splitting on the comma keeps only the part after it
        const base64 = String(reader.result).split(',')[1] || '';
        resolve(base64);
      };
      reader.onerror = () => reject(new Error('Could not read the selected file.'));
      reader.readAsDataURL(file);
    });
  }

  /** Clears any chosen screenshot and returns the upload box to its empty state. */
  function resetScreenshotField() {
    fileInput.value = '';
    screenshotData = null;
    previewWrap.style.display = 'none';
    dropLabel.style.display = 'flex';
    if (previewImg.src) previewImg.removeAttribute('src');
  }

  // clicking the upload box's visible label opens the native file picker
  // (this happens automatically via the <label for="screenshotFileInput">
  // association in the HTML — no JS needed for that part)

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files && fileInput.files[0];
    if (!file) return;

    if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
      // wrong file type selected (e.g. a PDF) — reject it and show the inline error
      screenshotError.style.display = 'block';
      resetScreenshotField();
      return;
    }
    screenshotError.style.display = 'none';

    try {
      const base64 = await readFileAsBase64(file);
      screenshotData = { base64, mimeType: file.type, fileName: file.name };

      // swap the upload box for the live preview + "Uploaded" success label
      previewImg.src = 'data:' + file.type + ';base64,' + base64;
      dropLabel.style.display = 'none';
      previewWrap.style.display = 'block';
      if (window.gsap) gsap.fromTo(previewWrap, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' });
    } catch (err) {
      console.error('Reading screenshot file failed:', err);
      screenshotError.textContent = 'Could not read that image. Please try a different file.';
      screenshotError.style.display = 'block';
      resetScreenshotField();
    }
  });

  // the small "Remove" link inside the preview clears the file and goes back to the empty upload box
  removeBtn.addEventListener('click', () => resetScreenshotField());

  // hides the "too short" UTR error as soon as the customer starts correcting it
  utrInput.addEventListener('input', () => { utrError.style.display = 'none'; });

  /**
   * Handles submitting the ENTIRE form in one go: validates the screenshot
   * and UTR alongside the usual required-field checks, sends everything
   * to Google Sheets together, and — if that succeeds — swaps the form
   * out for the final animated success state.
   */
  planForm.addEventListener('submit', async (e) => {
    e.preventDefault();             // stop the normal page-reload form submit
    errorEl.style.display = 'none'; // clear any error left over from a previous attempt
    screenshotError.style.display = 'none';
    utrError.style.display = 'none';

    // validates the two fields that <input required> can't check on its own
    // (a file input being "filled" doesn't guarantee it's an image we accept,
    // and a text input being "filled" doesn't guarantee it's long enough)
    let hasError = false;
    if (!screenshotData) {
      screenshotError.style.display = 'block';
      hasError = true;
    }
    if (utrInput.value.trim().length < MIN_UTR_LENGTH) {
      utrError.style.display = 'block';
      hasError = true;
    }
    if (hasError) return; // stop here — don't submit anything until both are valid

    const fd = new FormData(planForm); // reads all current values out of the form's inputs
    const payload = {
      formType: 'pricing',                          // tells the backend this is the pricing modal (matches doPost's routing)
      name: fd.get('name') || '',
      phone: fd.get('phone') || '',
      email: fd.get('email') || '',
      plan: planField.value,                       // the read-only plan name set by openModal()
      paymentOption: fd.get('paymentOption') || '', // "Full Payment" or "Advance Payment" radio choice
      transactionId: utrInput.value.trim(),
      screenshotBase64: screenshotData.base64,
      screenshotMimeType: screenshotData.mimeType,
      screenshotFileName: screenshotData.fileName,
      origin: fd.get('origin') || window.location.origin,
      clientIP: fd.get('clientIP') || sessionStorage.getItem('ryw_session_id') || 'unknown',
      csrfToken: CSRF_TOKEN, 
      timestamp: nowTimestamp()                     // exact moment of submission
    };

    const originalLabel = submitBtn.textContent; // remembered so we can restore the button label afterward
    submitBtn.disabled = true;        // stop the user from clicking submit twice while the request is in flight
    submitBtn.style.opacity = '0.6';
    submitBtn.textContent = 'Submitting…';

    try {
      const response = await postToSheet(GOOGLE_SHEET_PRICING_URL, payload); // sends everything in one request, gets back Apps Script's JSON reply
      const orderId = response && response.orderId ? response.orderId : null; // pulls out the RYW-2026-0042 style id, generated only now that the row actually exists

      finalOrderIdDisplay.textContent = orderId || 'Pending — check WhatsApp'; // shows it in the success view, with a safe fallback if it's ever missing
      planForm.style.display = 'none';          // hide the now-submitted form...
      finalSuccessState.style.display = 'flex'; // ...and reveal the animated success state
      dataLayer.push({ event: 'pricing_form_submitted', plan: planField.value });
      playSuccessAnimation();
    } catch (err) {
      // covers both network failures and the script reporting result:'error'
      console.error('Pricing form submission failed:', err); // logged for debugging, not shown to the visitor
      errorEl.style.display = 'block'; // shows the visitor a plain "something went wrong" message
    } finally {
      // always restore the button, whether the submission succeeded or failed
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.textContent = originalLabel;
    }
  });

  /**
   * Plays the circular "draw-on" success animation: the ring sweeps
   * around, the tick mark draws itself stroke-by-stroke, and the whole
   * badge glows and scales in. Pure GSAP, using the same easing language
   * as the rest of the site so it doesn't feel like a bolted-on widget.
   * Falls back to simply showing everything if GSAP isn't available.
   */
  function playSuccessAnimation() {
    const ring = document.getElementById('successRing');
    const tick = document.getElementById('successTick');
    const glow = document.getElementById('successGlow');
    const wrap = document.getElementById('successTickWrap');
    if (!ring || !tick) return;

    if (!window.gsap) {
      // fallback: just show everything instantly if GSAP somehow isn't loaded
      ring.style.strokeDashoffset = '0';
      tick.style.strokeDashoffset = '0';
      wrap.style.transform = 'scale(1)';
      wrap.style.opacity = '1';
      glow.style.opacity = '1';
      startAutoCloseCountdown(); // still auto-closes even without the animated entrance
      return;
    }

    const ringLength = ring.getTotalLength(); // the SVG circle's full circumference, used to animate it being "drawn"
    const tickLength = tick.getTotalLength(); // the tick path's own length, drawn the same way

    // start both paths fully hidden (dash offset = full length, so none of the stroke shows yet)
    gsap.set(ring, { strokeDasharray: ringLength, strokeDashoffset: ringLength });
    gsap.set(tick, { strokeDasharray: tickLength, strokeDashoffset: tickLength });
    gsap.set(wrap, { scale: 0.6, opacity: 0 });
    gsap.set(glow, { opacity: 0 });
    gsap.set('#planFinalSuccessState h3, #planFinalSuccessState p, #planFinalSuccessState > div:nth-of-type(2)', { opacity: 0, y: 10 });

    gsap.timeline()
      .to(wrap, { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(1.6)' })
      .to(glow, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '<')
      .to(ring, { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' }, '<0.1')
      .to(tick, { strokeDashoffset: 0, duration: 0.45, ease: 'power2.out' }, '-=0.15')
      .to('#planFinalSuccessState h3, #planFinalSuccessState p, #planFinalSuccessState > div:nth-of-type(2)', {
        opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.08
      }, '-=0.2')
      // once every entrance animation has finished, start the auto-close countdown —
      // this runs exactly once, right after the tick has fully drawn itself in
      .call(() => startAutoCloseCountdown());
  }

  /**
   * Counts down from 3 to 0 in the small "Returning to the website in
   * 3…" text, updating the number once per second, and then closes the
   * whole modal automatically once it reaches 0 — so the customer is
   * dropped back onto the main site without needing to click a button.
   *
   * Uses setInterval (fires repeatedly every 1000ms) rather than several
   * separate setTimeout calls, since a single repeating timer is simpler
   * to read and to cancel cleanly if it's ever needed.
   */
  function startAutoCloseCountdown() {
    const numberEl = document.getElementById('autoCloseCountdownNumber');
    let secondsLeft = 3; // matches the "3" already shown in the HTML as the starting point

    autoCloseIntervalId = setInterval(() => {
      secondsLeft -= 1;
      if (secondsLeft <= 0) {
        clearInterval(autoCloseIntervalId); // stop the timer — it's done its job
        autoCloseIntervalId = null;
        closeModal();                       // re-uses the exact same close animation/cleanup as the × button and the other Close buttons
        return;
      }
      if (numberEl) numberEl.textContent = String(secondsLeft);
    }, 1000);
  }
})();

// ==================== NEW: Auto-fill origin & session ID ====================
(function() {
  // 1. Origin (domain) — backend ko origin check ke liye chahiye
  var origin = window.location.origin; // e.g. "https://readyurweb.com"
