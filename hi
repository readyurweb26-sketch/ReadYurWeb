 */
industries.forEach(ind => {
  const tile = document.createElement('div');
  tile.className = 'industry-tile';
  // data-image holds the photo URL in the markup itself (per the request),
  // so anyone editing this later can find/replace it without reading JS —
  // though in this build the URL is also kept in the `industries` array above.
  tile.dataset.image = ind.image;

  // position:relative lets the image layer below stack correctly inside the tile;
  // overflow:hidden keeps the image's hover scale-up from poking outside the rounded tile corners
  tile.style.cssText = 'position:relative; overflow:hidden; background:var(--bg); padding:32px 18px; min-height:128px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px;';

  tile.innerHTML = `
    <!-- background photo layer: invisible and slightly zoomed-in until hovered -->
    <div class="industry-tile-photo lazy-bg" data-bg="${ind.image}" style="position:absolute; inset:0; z-index:0; opacity:0; transform:scale(1.08);
      background-size:cover; background-position:center;
      transition:opacity .5s ease, transform .5s ease;">
      <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(8,9,11,0.35) 0%, rgba(8,9,11,0.75) 100%);"></div>
    </div>

    <!-- icon + label layer: this is what's visible by default -->
    <div class="industry-tile-content" style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:14px; transition:opacity .4s ease, transform .4s ease;">
      <svg class="industry-tile-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="transition:opacity .35s ease, transform .35s ease;">
        <path d="${ind.icon}"/>
      </svg>
      <span style="font-size:13px; color:var(--ink-dim); text-align:center; transition:color .35s ease;">${ind.name}</span>
    </div>
  `;

  const photoLayer = tile.querySelector('.industry-tile-photo');
  const icon = tile.querySelector('.industry-tile-icon');
  const label = tile.querySelector('.industry-tile-content span');

  /** Shows the photo, fades the icon down, and brightens the label text — called on hover or tap. */
  function activate() {
    photoLayer.style.opacity = '1';
    photoLayer.style.transform = 'scale(1)';        // photo settles to its normal size as it fades in (subtle zoom-out feel)
    icon.style.opacity = '0';
    icon.style.transform = 'scale(0.85)';           // icon shrinks slightly as it fades, instead of just popping out
    label.style.color = 'var(--ink)';               // label gets brighter against the now-darker photo backdrop
  }
  /** Reverses activate() — called when the mouse leaves or a tap happens elsewhere. */
  function deactivate() {
    photoLayer.style.opacity = '0';
    photoLayer.style.transform = 'scale(1.08)';
    icon.style.opacity = '1';
    icon.style.transform = 'scale(1)';
    label.style.color = 'var(--ink-dim)';
  }

  // desktop/mouse behaviour: hover in, hover out
  tile.addEventListener('mouseenter', activate);
  tile.addEventListener('mouseleave', deactivate);

  // touch behaviour: tapping a tile toggles it open; tapping a different tile
  // closes any other open tile first, so only one photo is showing at a time on mobile
  tile.addEventListener('touchstart', (e) => {
    const isActive = photoLayer.style.opacity === '1';
    document.querySelectorAll('.industry-tile-photo').forEach(p => {
      p.style.opacity = '0';
      p.style.transform = 'scale(1.08)';
