 * being typed out three times. That's the whole point of the config
 * object: changing PRICING_CONFIG above is the only edit ever needed for
 * a price change, a new feature line, or moving which plan is highlighted.
 */
function renderPricingCards() {
  const grid = document.getElementById('pricingGrid');
  if (!grid) return;

  // fills in the section's own eyebrow + heading text from the config too,
  // so even that copy can be changed in one place if needed later
  const sectionEyebrowEl = document.getElementById('pricingSectionEyebrow');
  const sectionHeadingEl = document.getElementById('pricingSectionHeading');
  if (sectionEyebrowEl) sectionEyebrowEl.textContent = PRICING_CONFIG.sectionEyebrow;
  if (sectionHeadingEl) sectionHeadingEl.textContent = PRICING_CONFIG.sectionHeading;

  PRICING_CONFIG.plans.forEach(plan => {
    const card = document.createElement('div');
    // .price-card keeps it targetable by existing CSS/JS if any selector relies on that class;
    // it intentionally does NOT also get the generic .reveal-up class — unlike that class, this
    // card's entrance animation is handled by its own dedicated ScrollTrigger further below,
    // for the same reason the industry/bento/work grids do it that way: gsap.set('.reveal-up', ...)
    // runs once at page load, before these cards exist yet, so they'd never be picked up by it.
    card.className = 'price-card';

    // highlighted plan (the one marked highlighted:true in the config) gets the
    // brass border, the teal-tinted gradient background, and the glow shadow —
    // exactly the same styling the old static "Business Pro" card had
    const cardBg = plan.highlighted
      ? 'background:linear-gradient(165deg, var(--teal) 0%, var(--panel) 70%); border:1px solid var(--brass); box-shadow:0 30px 70px -30px rgba(201,166,104,0.25);'
      : 'background:var(--panel); border:1px solid var(--line);';

    card.style.cssText = `${cardBg} border-radius:20px; padding:36px 30px; display:flex; flex-direction:column; position:relative;`;

    // text/feature colors also shift slightly for the highlighted plan, matching the old markup
    const eyebrowColor = plan.highlighted ? 'color:var(--brass-bright);' : '';
    const priceColor = plan.highlighted ? 'color:var(--brass-bright);' : '';
    const featureTextColor = plan.highlighted ? 'var(--ink)' : 'var(--ink-dim)';
    const featureBulletColor = plan.highlighted ? 'var(--brass-bright)' : 'var(--brass)';
    const buttonClass = plan.highlighted ? 'btn btn-primary' : 'btn btn-ghost';

    // builds the <li> list of feature lines from the plan's features array
    const featuresHtml = plan.features.map(f =>
      `<li style="display:flex; gap:10px; font-size:14px; color:${featureTextColor};"><span style="color:${featureBulletColor};">—</span>${f}</li>`
    ).join('');

    // the small floating "MOST CHOSEN" badge only renders for the highlighted plan
    const badgeHtml = (plan.highlighted && plan.highlightBadgeText)
      ? `<div style="position:absolute; top:-13px; right:28px; background:var(--brass); color:#100C04; font-family:var(--mono); font-size:11px; font-weight:600; padding:6px 12px; border-radius:6px;">${plan.highlightBadgeText}</div>`
      : '';

    card.innerHTML = `
      ${badgeHtml}
      <div class="eyebrow" style="${eyebrowColor}">${plan.eyebrowLabel}</div>
      <div style="margin-top:18px; display:flex; align-items:baseline; gap:6px;">
        <span style="font-family:var(--serif); font-size:44px; font-weight:600; ${priceColor}">${plan.price}</span>
      </div>
      <p style="color:var(--ink-faint); font-size:13px; margin-top:6px;">${plan.billingNote}</p>
      <p style="color:var(--ink-dim); font-size:14px; margin-top:18px;">${plan.description}</p>
      <ul style="margin-top:24px; display:flex; flex-direction:column; gap:13px; flex:1;">
        ${featuresHtml}
      </ul>
      <button type="button" class="${buttonClass} plan-select-btn" data-plan="${plan.planNameForModal}" data-price="${plan.price}" style="margin-top:28px; justify-content:center; width:100%;">${plan.buttonLabel}</button>
    `;

    grid.appendChild(card);
  });
}
