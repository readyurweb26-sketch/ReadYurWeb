/* =================== LAZY BACKGROUND IMAGE LOADER =================== */
/**
 * Uses IntersectionObserver to load background images only when
 * the element is near the viewport. Falls back to immediate loading
 * if the browser doesn't support IntersectionObserver.
 */
(function() {
  const lazyElements = document.querySelectorAll('.lazy-bg');
  if (!lazyElements.length) return;

  if (!window.IntersectionObserver) {
    // Fallback: load all immediately
    lazyElements.forEach(el => {
      const bg = el.dataset.bg;
      if (bg) {
        if (el.classList.contains('work-bg')) {
          const accent = el.dataset.bgAccent || '#C9A668';
          el.style.backgroundImage = `linear-gradient(160deg, ${accent}40 0%, rgba(8,9,11,0.55) 70%), url('${bg}')`;
        } else {
          el.style.backgroundImage = `url('${bg}')`;
        }
      }
    });
    return;
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target;
        const bg = el.dataset.bg;
        if (bg) {
          if (el.classList.contains('work-bg')) {
            const accent = el.dataset.bgAccent || '#C9A668';
            el.style.backgroundImage = `linear-gradient(160deg, ${accent}40 0%, rgba(8,9,11,0.55) 70%), url('${bg}')`;
          } else {
            el.style.backgroundImage = `url('${bg}')`;
          }
        }
        observer.unobserve(el);
      }
    });
  }, { rootMargin: '200px' }); // start loading 200px before entering viewport

  lazyElements.forEach(el => observer.observe(el));
})();

/* =================== TYPEWRITER EFFECT ON EYEBROW LABELS =================== */
/**
 * Adds a subtle "typing" animation to the small uppercase mono labels
 * (the ones marked data-typewriter in the HTML — e.g. "FEATURED WORK",
 * "WHAT WE BUILD", "PRICING", "OUR TRUSTED PARTNERS"). When one of these
 * scrolls into view for the first time, its text is cleared and then
 * typed back in one character at a time. It only ever plays once per
 * label — scrolling past it and back up again won't replay it.
 *
 * This intentionally only targets elements with data-typewriter — the
 * big serif headings (h1/h2) are untouched, exactly as requested.
 *
 * Uses IntersectionObserver (a built-in browser API for "tell me when
 * this element enters/exits the viewport") rather than GSAP ScrollTrigger,
 * since this effect doesn't need scroll-linked scrubbing — it just needs
 * a single "has this come into view yet?" check, which is exactly what
 * IntersectionObserver is for for and keeps this independent of GSAP entirely.
 */
(function () {
  const labels = document.querySelectorAll('[data-typewriter]');
  if (!labels.length) return;

  // how long the whole typing animation takes for any one label, in
  // milliseconds — same total duration regardless of label length, so a
  // short label ("PRICING") and a long one ("WHO WE BUILD FOR") both
  // finish typing in about the same amount of time, just at different
  // per-character speeds
  const TOTAL_TYPE_DURATION_MS = 600;

  /**
   * Clears the label's current text, then re-adds it back one character
   * at a time using setInterval, until the full original text is restored.
   */
  function typeLabel(el) {
    const fullText = el.textContent; // remember the real text before clearing it
    if (!fullText) return;

    el.textContent = ''; // start empty — this is the "before typing starts" state
    // a blinking-cursor-like caret character is appended during typing for a
    // nicer effect, then removed once typing finishes
    const caret = document.createElement('span');
    caret.textContent = '|';
    caret.style.cssText = 'opacity:0.6; margin-left:1px;';
    el.appendChild(caret);

    let charIndex = 0;
    const perCharDelay = Math.max(18, TOTAL_TYPE_DURATION_MS / fullText.length); // never faster than ~18ms/char even for very long labels

    const intervalId = setInterval(() => {
      charIndex++;
      // rebuilds the visible text up to charIndex, then re-appends the caret after it
      el.textContent = fullText.slice(0, charIndex);
      el.appendChild(caret);

      if (charIndex >= fullText.length) {
        clearInterval(intervalId);
        caret.remove(); // typing is done — remove the caret so the label settles into its normal final state
      }
    }, perCharDelay);
  }

  // IntersectionObserver watches all the labels at once and calls this
  // callback whenever any of their visibility crosses the `threshold` below
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        typeLabel(entry.target);
        observer.unobserve(entry.target); // stop watching this one — it has already played, and should never play again
      }
    });
  }, {
    threshold: 0.6 // fires once roughly 60% of the label is visible, so it triggers right as the section comes into clear view rather than the instant a sliver peeks onscreen
  });

  labels.forEach(label => observer.observe(label));
})();


