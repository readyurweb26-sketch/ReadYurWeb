  el.textContent = t;
  marqueeTrack.appendChild(el);
});
// animates the track leftwards by exactly half its total width (i.e. the
// width of one un-duplicated copy of the list) and repeats forever (-1).
// Because of the duplication above, that exact distance is what makes the
// loop invisible — the track always looks the same the instant it resets.
